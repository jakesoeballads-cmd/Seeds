# Salin menjadi .env.local (lokal) atau isi di pengaturan Environment Variables Hostinger.
# Nilainya ada di Supabase: Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Alamat website Benih, dipakai untuk tautan login Google dan tautan bagikan.
NEXT_PUBLIC_SITE_URL=https://domain-benih-anda.com

# Isi true setelah provider Google diaktifkan di Supabase (Authentication → Providers → Google).
NEXT_PUBLIC_ENABLE_GOOGLE_LOGIN=false

# ───────────── Tahap 2: Benih & pembayaran ─────────────
# RAHASIA, hanya untuk server (jangan pernah diberi awalan NEXT_PUBLIC_).
# Supabase: Project Settings → API → service_role. Dipakai hanya untuk membuat & mencatat transaksi pembelian.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...service-role...

# Midtrans (QRIS, e-wallet, transfer bank). Dashboard Midtrans → Settings → Access Keys.
# Notification URL di Dashboard Midtrans: https://domain-benih-anda.com/api/payments/notification
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxx
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxx
# true untuk transaksi sungguhan (kunci produksi), false untuk sandbox.
MIDTRANS_IS_PRODUCTION=false

# PayPal (Orders API v2). developer.paypal.com → Apps & Credentials.
# sandbox untuk uji coba, live untuk transaksi sungguhan.
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=xxxxxxxx
PAYPAL_CLIENT_SECRET=xxxxxxxx
# PayPal tidak mendukung rupiah: tagihan dibuat dalam mata uang ini dengan kurs tetap (rupiah per 1 unit).
PAYPAL_CURRENCY=USD
PAYPAL_IDR_RATE=16000

# Hanya untuk uji coba: true menampilkan halaman simulasi (bayar berhasil/gagal) untuk metode
# yang kuncinya belum diisi. JANGAN diisi true di website live.
PAYMENT_SIMULATION=false
