# Server
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# Supabase (Project Settings > API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Service role key hanya untuk server. Jangan pernah dikirim ke browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Maps JavaScript API (batasi key ini per domain/HTTP referrer)
GOOGLE_MAPS_API_KEY=your-google-maps-key

# Midtrans (Dashboard > Settings > Access Keys)
# Kosongkan MIDTRANS_SERVER_KEY untuk mode simulasi tanpa Midtrans.
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=

# Harga 1 Benih dalam Rupiah
BENIH_PRICE_IDR=1000
