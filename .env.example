# Salin menjadi .env.local (lokal) atau isi di pengaturan Environment Variables Hostinger.
# Nilainya ada di Supabase: Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Alamat website Benih, dipakai untuk tautan login Google dan tautan bagikan.
NEXT_PUBLIC_SITE_URL=https://domain-benih-anda.com

# Isi true setelah provider Google diaktifkan di Supabase (Authentication → Providers → Google).
NEXT_PUBLIC_ENABLE_GOOGLE_LOGIN=false

# Google Maps (opsional). Tanpa kunci, peta memakai OpenStreetMap dan lokasi kegiatan memakai embed Google Maps biasa.
# Di Google Cloud Console aktifkan "Maps JavaScript API", "Maps Embed API", dan "Geocoding API" untuk kunci ini,
# lalu batasi kuncinya ke domain Benih (Application restrictions → Websites).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
