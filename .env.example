# Server
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000
# Zona waktu tampilan tanggal/jam kegiatan
TIME_ZONE=Asia/Jakarta

# Supabase (Project Settings > API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Service role key hanya untuk server. Jangan pernah dikirim ke browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Maps JavaScript API (batasi key ini per domain/HTTP referrer)
GOOGLE_MAPS_API_KEY=your-google-maps-key

# Midtrans (Dashboard > Settings > Access Keys)
# Kosongkan MIDTRANS_SERVER_KEY untuk mode simulasi tanpa Midtrans.
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
# Urutan metode pembayaran di Snap (QRIS = other_qris). Kanal harus aktif di dashboard Midtrans.
MIDTRANS_ENABLED_PAYMENTS=other_qris,gopay,shopeepay,bca_va,bni_va,bri_va,permata_va,echannel,other_va,credit_card

# PayPal (developer.paypal.com > Apps & Credentials). Kosongkan untuk mode simulasi.
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# PayPal tidak menerima Rupiah: tagihan dibuat dalam mata uang ini dengan kurs tetap
# (Rupiah per 1 unit). Perbarui kurs secara berkala.
PAYPAL_CURRENCY=USD
PAYPAL_IDR_RATE=16000

# Harga 1 Benih dalam Rupiah
BENIH_PRICE_IDR=2000
# Potongan penarikan saldo (persen) untuk pengembangan platform
WITHDRAWAL_FEE_PERCENT=2.5
