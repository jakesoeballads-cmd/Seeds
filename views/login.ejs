<%- include('partials/header') %>
<section class="card narrow">
  <h1><%= t('Masuk') %></h1>
  <% if (error) { %><p class="alert error"><%= error %></p><% } %>
  <%- include('partials/social-login', { label: t('Masuk'), next }) %>
  <form method="post" action="/login">
    <input type="hidden" name="next" value="<%= next %>">
    <label><%= t('Email') %> <input type="email" name="email" value="<%= values.email || '' %>" required autocomplete="email"></label>
    <label><%= t('Kata sandi') %> <input type="password" name="password" required autocomplete="current-password"></label>
    <button type="submit" class="btn"><%= t('Masuk') %></button>
  </form>
  <p class="muted"><%= t('Belum punya akun?') %> <a href="/register"><%= t('Daftar sebagai relawan/donatur') %></a></p>
</section>
<%- include('partials/footer') %>
