<%- include('partials/header') %>
<section class="card narrow">
  <h1><%= t('Daftar') %></h1>
  <p class="muted"><%= t('Bergabung sebagai relawan atau donatur Benih.') %></p>
  <% if (error) { %><p class="alert error"><%= error %></p><% } %>
  <% if (typeof info !== 'undefined' && info) { %><p class="alert success"><%= info %></p><% } %>
  <%- include('partials/social-login', { label: t('Daftar'), next: '/dashboard' }) %>
  <form method="post" action="/register">
    <label><%= t('Nama lengkap') %> <input type="text" name="full_name" value="<%= values.full_name || '' %>" required autocomplete="name"></label>
    <label><%= t('Email') %> <input type="email" name="email" value="<%= values.email || '' %>" required autocomplete="email"></label>
    <label><%= t('Kata sandi') %> <input type="password" name="password" minlength="8" required autocomplete="new-password"></label>
    <button type="submit" class="btn"><%= t('Daftar') %></button>
  </form>
  <p class="muted"><%= t('Sudah punya akun?') %> <a href="/login"><%= t('Masuk') %></a></p>
</section>
<%- include('partials/footer') %>
