<%- include('partials/header') %>
<% const rupiah = (n) => 'Rp' + Number(n).toLocaleString('id-ID'); %>
<% const tanggal = (iso) => new Date(iso).toLocaleDateString('id-ID', { dateStyle: 'medium' }); %>
<h1>Halo, <%= fullName || 'Member' %></h1>

<div class="stats">
  <div class="stat">
    <span class="stat-label">Benih dimiliki</span>
    <span class="stat-value">🌱 <%= balance.toLocaleString('id-ID') %></span>
    <span class="muted"><%= rupiah(balanceIdr) %></span>
    <a href="/benih" class="btn small">Beli / Tarik</a>
  </div>

  <div class="stat">
    <span class="stat-label">Benih disumbangkan</span>
    <span class="stat-value">💚 <%= donated.toLocaleString('id-ID') %></span>
    <% if (badge.current) { %>
      <span class="badge-donor"><%= badge.current.icon %> <%= badge.current.name %></span>
    <% } else { %>
      <span class="muted">Belum ada badge</span>
    <% } %>
    <% if (badge.next) { %>
      <div class="progress" role="progressbar" aria-valuenow="<%= Math.round(badge.progress * 100) %>" aria-valuemin="0" aria-valuemax="100">
        <div style="width: <%= Math.round(badge.progress * 100) %>%"></div>
      </div>
      <span class="muted"><%= badge.remaining.toLocaleString('id-ID') %> Benih lagi menuju <%= badge.next.icon %> <%= badge.next.name %></span>
    <% } else { %>
      <span class="muted">Tingkat badge tertinggi tercapai. Terima kasih!</span>
    <% } %>
  </div>

  <div class="stat">
    <span class="stat-label">Benih didapat dari event</span>
    <span class="stat-value">🌳 <%= totalReceived.toLocaleString('id-ID') %></span>
    <span class="muted">dari <%= programs.length %> kegiatan yang kamu adakan</span>
    <a href="/program/baru" class="btn small">Buat kegiatan</a>
  </div>
</div>

<section class="card">
  <h2>Kegiatan yang kamu adakan</h2>
  <% if (!programs.length) { %>
    <p class="muted">Belum ada kegiatan. <a href="/program/baru">Buat kegiatan pertamamu</a>.</p>
  <% } else { %>
    <table class="table">
      <thead><tr><th>Kegiatan</th><th>Tanggal</th><th>Benih terkumpul</th></tr></thead>
      <tbody>
        <% programs.forEach((p) => { %>
          <tr>
            <td><%= p.title %><% if (p.location_name) { %><br><span class="muted"><%= p.location_name %></span><% } %></td>
            <td><%= tanggal(p.start_at) %></td>
            <td>
              <strong><%= Number(p.benih_collected).toLocaleString('id-ID') %></strong><% if (p.benih_target) { %> / <%= p.benih_target.toLocaleString('id-ID') %><% } %>
              <br><span class="muted"><%= rupiah(p.benih_collected * price) %></span>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</section>

<section class="card">
  <h2>Donasi terakhirmu</h2>
  <% if (!recentDonations.length) { %>
    <p class="muted">Belum ada donasi. Cari kegiatan di <a href="/">beranda</a>.</p>
  <% } else { %>
    <ul class="history">
      <% recentDonations.forEach((d) => { %>
        <li><span><%= d.program ? d.program.title : 'Kegiatan' %> · <%= tanggal(d.created_at) %></span><strong><%= d.benih_amount %> Benih</strong></li>
      <% }) %>
    </ul>
  <% } %>
</section>

<section class="card">
  <h2>Tingkatan badge donatur</h2>
  <ul class="badge-list">
    <% badges.forEach((b) => { %>
      <li class="<%= donated >= b.min ? 'earned' : '' %>"><%= b.icon %> <strong><%= b.name %></strong> <span class="muted">≥ <%= b.min.toLocaleString('id-ID') %> Benih</span></li>
    <% }) %>
  </ul>
</section>
<%- include('partials/footer') %>
