<%- include('partials/header') %>
<% const rupiah = (n) => 'Rp' + Number(n).toLocaleString('id-ID'); %>
<% const tanggal = (iso) => new Date(iso).toLocaleDateString('id-ID', { dateStyle: 'medium' }); %>
<% const statusLabel = { registered: 'Terdaftar', attended: 'Hadir', negotiating: 'Berdiskusi', agreed: 'Disepakati', paid: 'Dibayar', cancelled: 'Batal' }; %>
<% const badgeTile = (b, unit) => { %>
    <% if (b.current) { %>
      <span class="badge-donor"><%= b.current.icon %> <%= b.current.name %></span>
    <% } else { %>
      <span class="muted">Belum ada badge</span>
    <% } %>
    <% if (b.next) { %>
      <div class="progress" role="progressbar" aria-valuenow="<%= Math.round(b.progress * 100) %>" aria-valuemin="0" aria-valuemax="100">
        <div style="width: <%= Math.round(b.progress * 100) %>%"></div>
      </div>
      <span class="muted"><%= b.remaining.toLocaleString('id-ID') %> <%= unit %> lagi menuju <%= b.next.icon %> <%= b.next.name %></span>
    <% } else { %>
      <span class="muted">Tingkat badge tertinggi tercapai. Terima kasih!</span>
    <% } %>
<% } %>
<h1>Halo, <%= fullName || 'Member' %></h1>

<div class="stats">
  <div class="stat">
    <span class="stat-label">Benih dimiliki</span>
    <span class="stat-value">🌱 <%= balance.toLocaleString('id-ID') %></span>
    <span class="muted"><%= rupiah(balanceIdr) %></span>
    <a href="/benih" class="btn small">Beli / Tarik</a>
  </div>

  <div class="stat">
    <span class="stat-label">Benih disumbangkan</span>
    <span class="stat-value">💚 <%= donated.toLocaleString('id-ID') %></span>
    <% badgeTile(badge, 'Benih') %>
  </div>

  <div class="stat">
    <span class="stat-label">Poin relawan</span>
    <span class="stat-value">🤝 <%= volunteerPoints.toLocaleString('id-ID') %></span>
    <% badgeTile(volunteerBadge, 'poin') %>
    <span class="muted"><%= volunteerEvents %> kegiatan sebagai relawan · <%= pointsPerEvent %> poin per kegiatan</span>
  </div>

  <div class="stat">
    <span class="stat-label">Benih didapat dari event</span>
    <span class="stat-value">🌳 <%= totalReceived.toLocaleString('id-ID') %></span>
    <span class="muted">dari <%= programs.length %> kegiatan yang kamu adakan</span>
    <a href="/program/baru" class="btn small">Buat kegiatan</a>
  </div>
</div>

<section class="card">
  <h2>Rekam jejak partisipasi</h2>
  <% if (!participations.length) { %>
    <p class="muted">Kamu belum mengikuti kegiatan. Cari kegiatan di <a href="/">beranda</a>.</p>
  <% } else { %>
    <div class="table-wrap"><table class="table">
      <thead><tr><th>Kegiatan</th><th>Tanggal</th><th>Peran</th><th>Status</th></tr></thead>
      <tbody>
        <% participations.forEach((x) => { const p = x.program || {}; %>
          <tr>
            <td><a href="/kegiatan/<%= p.id %>"><%= p.title %></a><br><span class="muted">oleh <%= p.organizer_name %></span></td>
            <td><%= p.start_at ? tanggal(p.start_at) : '' %></td>
            <td><%= x.role === 'paid' ? 'Tenaga berbayar' : 'Relawan' %></td>
            <td><span class="badge <%= x.status %>"><%= statusLabel[x.status] %></span>
              <% if (x.role === 'volunteer' && x.status === 'attended') { %><br><span class="muted">+<%= pointsPerEvent %> poin</span><% } %>
              <% if (x.role === 'paid' && x.agreed_benih) { %><br><span class="muted"><%= x.agreed_benih %> Benih</span><% } %>
              <% if (x.role === 'paid' && x.status !== 'paid') { %><br><a href="/kegiatan/<%= p.id %>/pesan">Pesan</a><% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table></div>
  <% } %>
</section>

<section class="card">
  <h2>Kegiatan yang kamu adakan</h2>
  <% if (!programs.length) { %>
    <p class="muted">Belum ada kegiatan. <a href="/program/baru">Buat kegiatan pertamamu</a>.</p>
  <% } else { %>
    <table class="table">
      <thead><tr><th>Kegiatan</th><th>Tanggal</th><th>Benih terkumpul</th></tr></thead>
      <tbody>
        <% programs.forEach((p) => { %>
          <tr>
            <td><a href="/kegiatan/<%= p.id %>"><%= p.title %></a><% if (p.location_name) { %><br><span class="muted"><%= p.location_name %></span><% } %></td>
            <td><%= tanggal(p.start_at) %></td>
            <td>
              <strong><%= Number(p.benih_collected).toLocaleString('id-ID') %></strong><% if (p.benih_target) { %> / <%= p.benih_target.toLocaleString('id-ID') %><% } %>
              <br><span class="muted"><%= rupiah(p.benih_collected * price) %></span>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</section>

<section class="card">
  <h2>Donasi terakhirmu</h2>
  <% if (!recentDonations.length) { %>
    <p class="muted">Belum ada donasi. Cari kegiatan di <a href="/">beranda</a>.</p>
  <% } else { %>
    <ul class="history">
      <% recentDonations.forEach((d) => { %>
        <li><span><%= d.program ? d.program.title : 'Kegiatan' %> · <%= tanggal(d.created_at) %></span><strong><%= d.benih_amount %> Benih</strong></li>
      <% }) %>
    </ul>
  <% } %>
</section>

<div class="badge-columns">
<section class="card">
  <h2>Badge donatur</h2>
  <ul class="badge-list">
    <% badges.forEach((b) => { %>
      <li class="<%= donated >= b.min ? 'earned' : '' %>"><%= b.icon %> <strong><%= b.name %></strong> <span class="muted">≥ <%= b.min.toLocaleString('id-ID') %> Benih disumbangkan</span></li>
    <% }) %>
  </ul>
</section>
<section class="card">
  <h2>Badge relawan</h2>
  <ul class="badge-list">
    <% volunteerBadges.forEach((b) => { %>
      <li class="<%= volunteerPoints >= b.min ? 'earned' : '' %>"><%= b.icon %> <strong><%= b.name %></strong> <span class="muted">≥ <%= b.min.toLocaleString('id-ID') %> poin (<%= b.min / pointsPerEvent %> kegiatan)</span></li>
    <% }) %>
  </ul>
</section>
</div>
<%- include('partials/footer') %>
