<%- include('partials/header') %>
<section class="card narrow" style="max-width:640px">
  <h1><%= t('Pesan') %></h1>
  <% if (!conversations.length) { %>
    <p class="muted"><%= t('Belum ada percakapan. Kirim pesan dari profil member atau halaman kegiatan.') %></p>
  <% } else { %>
    <ul class="inbox">
      <% conversations.forEach((c) => { %>
        <li class="<%= c.unread ? 'unread' : '' %>">
          <a href="<%= c.url %>">
            <%- include('partials/avatar', { url: c.avatarUrl, name: c.otherName, size: '' }) %>
            <span class="inbox-text">
              <span class="inbox-top">
                <strong><%= c.otherName || t('Member') %></strong>
                <time datetime="<%= c.lastAt %>"><%= fmt.when(c.lastAt) %></time>
              </span>
              <% if (c.kind === 'program') { %><span class="inbox-tag">🌱 <%= c.programTitle %></span><% } %>
              <span class="inbox-preview"><%= c.lastFromMe ? t('Kamu') + ': ' : '' %><%= c.lastBody %></span>
            </span>
            <% if (c.unread) { %><span class="count-badge" aria-label="<%= t('{n} belum dibaca', { n: c.unread }) %>"><%= c.unread %></span><% } %>
          </a>
        </li>
      <% }) %>
    </ul>
  <% } %>
</section>
<%- include('partials/footer') %>
