<%- include('partials/header') %>
<section class="card">
  <h1>Buat Kegiatan</h1>
  <p class="muted">Klik peta untuk menandai lokasi kegiatan.</p>
  <p id="form-message" class="alert" hidden></p>
  <form id="program-form" class="grid-form">
    <label>Judul <input type="text" name="title" minlength="3" required></label>
    <label>Nama penyelenggara
      <input type="text" name="organizer_name" minlength="2" maxlength="120" required value="<%= defaultOrganizer %>" placeholder="Nama kamu, komunitas, organisasi, atau badan usaha">
    </label>
    <label>Jenis penyelenggara
      <select name="organizer_type">
        <option value="perorangan">Perorangan</option>
        <option value="komunitas">Komunitas</option>
        <option value="organisasi">Organisasi</option>
        <option value="badan_usaha">Badan usaha</option>
      </select>
    </label>
    <label>Kategori
      <select name="category">
        <option value="reforestasi">Reforestasi</option>
        <option value="mangrove">Penanaman mangrove</option>
        <option value="bersih-pantai">Bersih pantai</option>
        <option value="edukasi">Edukasi lingkungan</option>
        <option value="lainnya">Lainnya</option>
      </select>
    </label>
    <label class="full">Deskripsi <textarea name="description" rows="4"></textarea></label>
    <label class="full">Foto kegiatan (maks. 5, JPG/PNG/WebP, masing-masing maks. 5 MB)
      <input type="file" name="photos" accept="image/jpeg,image/png,image/webp" multiple>
    </label>
    <div class="full gallery" id="photo-preview"></div>
    <label>Nama lokasi <input type="text" name="location_name" placeholder="cth. Hutan Kota Srengseng"></label>
    <label>Maks. peserta <input type="number" name="max_participants" min="1"></label>
    <label>Mulai <input type="datetime-local" name="start_at" required></label>
    <label>Selesai <input type="datetime-local" name="end_at"></label>
    <label>Target donasi (Benih, opsional) <input type="number" name="benih_target" min="1"></label>
    <div class="full">
      <div id="picker-map" class="map small" data-maps-key="<%= mapsKey %>">
        <% if (!mapsKey) { %><p class="muted">Peta nonaktif. Isi koordinat secara manual.</p><% } %>
      </div>
    </div>
    <label>Latitude <input type="number" name="lat" step="any" required></label>
    <label>Longitude <input type="number" name="lng" step="any" required></label>
    <div class="full"><button type="submit" class="btn">Simpan kegiatan</button></div>
  </form>
</section>
<script src="/js/program-new.js"></script>
<% if (mapsKey) { %>
  <script async src="https://maps.googleapis.com/maps/api/js?key=<%= encodeURIComponent(mapsKey) %>&callback=initPickerMap&loading=async"></script>
<% } %>
<%- include('partials/footer') %>
