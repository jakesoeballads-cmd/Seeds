<%- include('partials/header') %>
<section class="card narrow">
  <% if (status === 'success') { %>
    <h1><%= t('Terima kasih') %></h1>
    <p class="alert success"><%= t('Pembayaran berhasil. Saldo Benih kamu sudah bertambah.') %></p>
  <% } else if (status === 'cancelled' || status === 'failed') { %>
    <h1><%= t('Pembayaran dibatalkan') %></h1>
    <p><%= t('Tidak ada dana yang ditarik dan saldo Benih tidak berubah.') %></p>
  <% } else { %>
    <h1><%= t('Terima kasih') %></h1>
    <p><% if (orderId) { %><%- t('Pembayaran untuk order {order} sedang diproses.', { order: '<code>' + esc(orderId) + '</code>' }) %><% } else { %><%= t('Pembayaran sedang diproses.') %><% } %>
      <%= t('Saldo Benih bertambah setelah pembayaran dikonfirmasi.') %></p>
  <% } %>
  <a href="/benih" class="btn"><%= t('Lihat saldo') %></a>
</section>
<%- include('partials/footer') %>
