<%- include('partials/header') %>
<% const statusLabel = { registered: 'Terdaftar', attended: 'Hadir', negotiating: 'Berdiskusi', agreed: 'Disepakati', paid: 'Dibayar', cancelled: 'Batal' }; %>
<% const shareText = t('Ayo dukung kegiatan "{title}" di Benih!', { title: program.title }); %>
<div class="program-layout" data-program-id="<%= program.id %>">
  <article class="stack">
    <% if (program.photo_urls && program.photo_urls.length) { %>
      <div class="gallery">
        <% program.photo_urls.forEach((url, i) => { %><img src="<%= url %>" alt="<%= t('Foto kegiatan {n}', { n: i + 1 }) %>" loading="lazy"><% }) %>
      </div>
    <% } %>
    <header>
      <h1 style="margin-bottom:4px"><%= program.title %></h1>
      <p style="margin:0"><%- t('oleh {name}', { name: `<a class="org-link" href="/member/${esc(program.organizer_id)}"><strong>${esc(program.organizer_name)}</strong></a>` }) %>
        <span class="org-type"><%= t(organizerTypes[program.organizer_type]) %></span></p>
    </header>
    <p class="muted" style="margin:0">📅 <%= fmt.schedule(program.start_at, program.end_at, 'full') %><br>📍 <%= program.location_name || `${program.lat}, ${program.lng}` %>
      <br>👥 <%= t('{n} peserta', { n: participantCount + (program.max_participants ? ` / ${program.max_participants}` : '') }) %></p>
    <% if (program.description) { %><p style="white-space:pre-line;max-width:70ch"><%= program.description %></p><% } %>
    <div>
      <% if (program.benih_target) { %>
        <div class="progress"><div style="width: <%= Math.min(100, Math.round(program.benih_collected / program.benih_target * 100)) %>%"></div></div>
      <% } %>
      <p class="muted">🌱 <strong><%= fmt.num(program.benih_collected) %></strong><%= program.benih_target ? ` / ${fmt.num(program.benih_target)}` : '' %> <%= t('Benih terkumpul') %></p>
    </div>

    <% if (isOrganizer) { %>
      <section class="card">
        <h2 style="margin-top:0"><%= t('Peserta') %></h2>
        <p class="muted"><%= t('Konfirmasi kehadiran relawan agar mereka mendapat {n} poin relawan. Untuk tenaga berbayar, sepakati jumlah Benih lewat pesan, catat kesepakatannya, lalu bayar setelah kegiatan.', { n: pointsPerEvent }) %></p>
        <% if (!participants.length) { %>
          <p class="muted"><%= t('Belum ada peserta.') %></p>
        <% } else { %>
          <div class="table-wrap"><table class="table">
            <thead><tr><th><%= t('Nama') %></th><th><%= t('Peran') %></th><th><%= t('Status') %></th><th><%= t('Aksi') %></th></tr></thead>
            <tbody>
            <% participants.forEach((p) => { %>
              <tr data-user="<%= p.user_id %>">
                <td><%= (p.profile && p.profile.full_name) || t('Member') %></td>
                <td><%= p.role === 'paid' ? t('Tenaga berbayar') : t('Relawan') %></td>
                <td><span class="badge <%= p.status %>"><%= t(statusLabel[p.status]) %></span><%= p.agreed_benih ? ` · ${p.agreed_benih} Benih` : '' %></td>
                <td><div class="row">
                  <% if (p.role === 'volunteer' && p.status === 'registered') { %>
                    <button class="btn small" data-act="attended"><%= t('Konfirmasi hadir') %></button>
                  <% } %>
                  <% if (p.role === 'paid') { %>
                    <a class="btn small ghost" href="/kegiatan/<%= program.id %>/pesan/<%= p.user_id %>"><%= t('Pesan') %></a>
                    <% if (p.status === 'negotiating' || p.status === 'agreed') { %>
                      <form class="row" data-act="agreement" style="display:flex;flex-direction:row;gap:6px">
                        <input type="number" name="benih_amount" min="1" placeholder="Benih" value="<%= p.agreed_benih || '' %>" style="width:90px" aria-label="<%= t('Benih yang disepakati') %>">
                        <button class="btn small ghost" type="submit"><%= t('Simpan') %></button>
                      </form>
                    <% } %>
                    <% if (p.status === 'agreed') { %>
                      <button class="btn small" data-act="pay"><%= t('Bayar {n} Benih', { n: fmt.num(p.agreed_benih) }) %></button>
                    <% } %>
                  <% } %>
                </div></td>
              </tr>
            <% }) %>
            </tbody>
          </table></div>
        <% } %>
        <p id="manage-message" class="alert" hidden></p>
      </section>
    <% } %>
  </article>

  <aside class="stack">
    <% if (!isOrganizer) { %>
    <section class="card stack" style="gap:12px">
      <h2 style="margin:0"><%= t('Ikuti kegiatan') %></h2>
      <% if (!user) { %>
        <p class="muted" style="margin:0"><%= t('Masuk untuk mengikuti kegiatan ini.') %></p>
        <a class="btn" href="/login?next=/kegiatan/<%= program.id %>"><%= t('Masuk atau daftar') %></a>
      <% } else if (participation) { %>
        <% if (participation.role === 'volunteer') { %>
          <p class="alert success" style="margin:0"><%- t('Kamu terdaftar sebagai {role}', { role: `<strong>${esc(t('relawan'))}</strong>` }) %> · <%= t(statusLabel[participation.status]) %></p>
          <p class="muted" style="margin:0"><%= participation.status === 'attended' ? t('Kehadiranmu sudah dikonfirmasi: +{n} poin relawan.', { n: pointsPerEvent }) : t('Kamu mendapat {n} poin relawan setelah penyelenggara mengonfirmasi kehadiranmu.', { n: pointsPerEvent }) %></p>
        <% } else { %>
          <p class="alert info" style="margin:0"><%- t('Kamu mendaftar sebagai {role}', { role: `<strong>${esc(t('tenaga berbayar'))}</strong>` }) %> · <%= t(statusLabel[participation.status]) %><%= participation.agreed_benih ? ` · ${participation.agreed_benih} Benih` : '' %></p>
          <a class="btn" href="/kegiatan/<%= program.id %>/pesan"><%= t('Pesan penyelenggara') %></a>
        <% } %>
      <% } else { %>
        <form id="join-form" class="stack" style="gap:12px">
          <div class="role-options" role="radiogroup" aria-label="<%= t('Ikut sebagai') %>">
            <label class="role-option"><input type="radio" name="role" value="volunteer" checked>
              <strong><%= t('Relawan') %></strong><br><span class="muted"><%= t('Tanpa imbal balik Benih. Kamu mendapat poin dan badge relawan.') %></span></label>
            <label class="role-option"><input type="radio" name="role" value="paid">
              <strong><%= t('Tenaga berbayar') %></strong><br><span class="muted"><%= t('Dapat imbal balik Benih. Kamu akan diarahkan ke percakapan dengan penyelenggara untuk menyepakati jumlahnya.') %></span></label>
          </div>
          <button class="btn" type="submit"><%= t('Ikuti kegiatan') %></button>
        </form>
      <% } %>
      <p id="join-message" class="alert" hidden></p>
    </section>

    <section class="card stack" style="gap:12px">
      <h2 style="margin:0"><%= t('Dukung dengan Benih') %></h2>
      <% if (user) { %>
        <form id="donate-form" class="stack" style="gap:8px">
          <label><%= t('Jumlah Benih') %> <input type="number" name="benih_amount" min="1" value="10" required></label>
          <label><%= t('Pesan (opsional)') %> <input type="text" name="message" maxlength="280"></label>
          <button class="btn" type="submit"><%= t('Donasi') %></button>
        </form>
        <p id="donate-message" class="alert" hidden></p>
      <% } else { %>
        <a class="btn ghost" href="/login?next=/kegiatan/<%= program.id %>"><%= t('Masuk untuk berdonasi') %></a>
      <% } %>
    </section>
    <% } else { %>
    <section class="card"><p class="alert success" style="margin:0"><%= t('Ini kegiatan yang kamu adakan.') %></p></section>
    <% } %>

    <section class="card stack" style="gap:12px">
      <h2 style="margin:0"><%= t('Bagikan') %></h2>
      <div class="share">
        <a class="btn small ghost" target="_blank" rel="noopener" href="https://wa.me/?text=<%= encodeURIComponent(shareText + ' ' + shareUrl) %>">WhatsApp</a>
        <a class="btn small ghost" target="_blank" rel="noopener" href="https://www.facebook.com/sharer/sharer.php?u=<%= encodeURIComponent(shareUrl) %>">Facebook</a>
        <a class="btn small ghost" target="_blank" rel="noopener" href="https://x.com/intent/post?text=<%= encodeURIComponent(shareText) %>&url=<%= encodeURIComponent(shareUrl) %>">X</a>
        <a class="btn small ghost" target="_blank" rel="noopener" href="https://www.threads.net/intent/post?text=<%= encodeURIComponent(shareText + ' ' + shareUrl) %>">Threads</a>
        <button class="btn small ghost" type="button" id="copy-link" data-url="<%= shareUrl %>"><%= t('Salin tautan') %></button>
        <button class="btn small ghost" type="button" id="native-share" data-url="<%= shareUrl %>" data-text="<%= shareText %>" hidden><%= t('Bagikan…') %></button>
      </div>
      <p class="muted" style="margin:0;font-size:.85rem"><%= t('Untuk Instagram, salin tautan lalu tempel di story atau bio.') %></p>
    </section>
  </aside>
</div>
<script src="/js/program.js"></script>
<%- include('partials/footer') %>
