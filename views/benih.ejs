<%- include('partials/header') %>
<section class="card narrow">
  <h1><%= t('Beli & Tarik Benih') %></h1>
  <p class="balance"><%= t('Saldo Benih') %>: <strong><%= fmt.num(balance) %></strong> Benih
    (<%= fmt.rupiah(balance * price) %>)</p>
  <p class="muted"><%= t('Saldo bisa didonasikan ke kegiatan member lain atau ditarik ke rekening.') %></p>
  <% if (simulated || paypal.simulated) { %>
    <p class="alert info"><%= t('Mode simulasi aktif: pembayaran tidak benar-benar diproses.') %></p>
  <% } %>
  <form id="buy-form" data-price="<%= price %>" data-simulated="<%= simulated %>" data-paypal-rate="<%= paypal.idrRate %>" data-paypal-currency="<%= paypal.currency %>">
    <label><%= t('Jumlah Benih') %> <input type="number" name="benih_amount" min="1" max="100000" value="10" required></label>
    <fieldset class="pay-methods">
      <legend><%= t('Metode pembayaran') %></legend>
      <label class="role-option"><input type="radio" name="method" value="midtrans" checked>
        <strong><%= t('QRIS, e-wallet, atau transfer bank') %></strong><br><span class="muted"><%= t('Lewat Midtrans, dibayar dalam Rupiah.') %></span></label>
      <label class="role-option"><input type="radio" name="method" value="paypal">
        <strong>PayPal</strong><br><span class="muted"><%= t('Untuk kartu dan akun internasional. Dibayar dalam {currency} dengan kurs Rp{rate} = 1 {currency}.', { currency: paypal.currency, rate: fmt.num(paypal.idrRate) }) %></span></label>
    </fieldset>
    <p class="muted"><%= t('Total') %>: <strong id="total">Rp0</strong> (<%= t('{price} per Benih', { price: fmt.rupiah(price) }) %>)</p>
    <button type="submit" class="btn"><%= t('Bayar') %></button>
  </form>
  <p id="buy-message" class="alert" hidden></p>
</section>

<section class="card narrow">
  <h2><%= t('Tarik saldo') %></h2>
  <p class="muted"><%= t('Penarikan dipotong {fee}% untuk pengembangan platform.', { fee: fmt.num(feePercent) }) %></p>
  <form id="withdraw-form" data-price="<%= price %>" data-fee-bps="<%= feeBps %>">
    <label><%= t('Jumlah Benih') %> <input type="number" name="benih_amount" min="1" max="<%= balance %>" required <%= balance < 1 ? 'disabled' : '' %>></label>
    <label><%= t('Nama bank') %> <input type="text" name="bank_name" placeholder="<%= t('cth. BCA') %>" required></label>
    <label><%= t('Nomor rekening') %> <input type="text" name="bank_account_number" inputmode="numeric" required></label>
    <label><%= t('Nama pemilik rekening') %> <input type="text" name="bank_account_name" required></label>
    <p class="muted" id="withdraw-breakdown"></p>
    <button type="submit" class="btn" <%= balance < 1 ? 'disabled' : '' %>><%= t('Ajukan penarikan') %></button>
  </form>
  <p id="withdraw-message" class="alert" hidden></p>
  <h3><%= t('Riwayat penarikan') %></h3>
  <ul id="withdrawals" class="history"><li class="muted"><%= t('Memuat…') %></li></ul>
</section>

<section class="card narrow">
  <h2><%= t('Riwayat transaksi') %></h2>
  <ul id="history" class="history"><li class="muted"><%= t('Memuat…') %></li></ul>
</section>

<% if (!simulated && clientKey) { %>
  <script src="<%= snapJsUrl %>" data-client-key="<%= clientKey %>"></script>
<% } %>
<script src="/js/benih.js"></script>
<%- include('partials/footer') %>
