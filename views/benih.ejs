<%- include('partials/header') %>
<section class="card narrow">
  <h1>Beli & Tarik Benih</h1>
  <p class="balance">Saldo Benih: <strong><%= balance %></strong> Benih
    (Rp<%= (balance * price).toLocaleString('id-ID') %>)</p>
  <p class="muted">Saldo bisa didonasikan ke kegiatan member lain atau ditarik ke rekening.</p>
  <% if (simulated) { %>
    <p class="alert info">Mode simulasi aktif: pembayaran tidak benar-benar diproses.</p>
  <% } %>
  <form id="buy-form" data-price="<%= price %>" data-simulated="<%= simulated %>">
    <label>Jumlah Benih <input type="number" name="benih_amount" min="1" max="100000" value="10" required></label>
    <p class="muted">Total: <strong id="total">Rp0</strong> (Rp<%= price.toLocaleString('id-ID') %> per Benih)</p>
    <button type="submit" class="btn">Bayar</button>
  </form>
  <p id="buy-message" class="alert" hidden></p>
</section>

<section class="card narrow">
  <h2>Tarik saldo</h2>
  <p class="muted">Penarikan dipotong <%= feePercent.toLocaleString('id-ID') %>% untuk pengembangan platform.</p>
  <form id="withdraw-form" data-price="<%= price %>" data-fee-bps="<%= feeBps %>">
    <label>Jumlah Benih <input type="number" name="benih_amount" min="1" max="<%= balance %>" required <%= balance < 1 ? 'disabled' : '' %>></label>
    <label>Nama bank <input type="text" name="bank_name" placeholder="cth. BCA" required></label>
    <label>Nomor rekening <input type="text" name="bank_account_number" inputmode="numeric" required></label>
    <label>Nama pemilik rekening <input type="text" name="bank_account_name" required></label>
    <p class="muted" id="withdraw-breakdown"></p>
    <button type="submit" class="btn" <%= balance < 1 ? 'disabled' : '' %>>Ajukan penarikan</button>
  </form>
  <p id="withdraw-message" class="alert" hidden></p>
  <h3>Riwayat penarikan</h3>
  <ul id="withdrawals" class="history"><li class="muted">Memuat…</li></ul>
</section>

<section class="card narrow">
  <h2>Riwayat transaksi</h2>
  <ul id="history" class="history"><li class="muted">Memuat…</li></ul>
</section>

<% if (!simulated && clientKey) { %>
  <script src="<%= snapJsUrl %>" data-client-key="<%= clientKey %>"></script>
<% } %>
<script src="/js/benih.js"></script>
<%- include('partials/footer') %>
