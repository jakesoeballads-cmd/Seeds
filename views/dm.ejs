<%- include('partials/header') %>
<section class="card narrow stack" style="gap:12px;max-width:640px" data-chat data-url="/api/messages/<%= other.id %>" data-me="<%= user.id %>">
  <p style="margin:0"><a href="/pesan">← <%= t('Semua pesan') %></a></p>
  <div class="chat-head">
    <%- include('partials/avatar', { url: other.avatar_url, name: other.full_name, size: '' }) %>
    <h1 style="margin:0"><a class="org-link" href="/member/<%= other.id %>"><%= other.full_name || t('Member') %></a></h1>
  </div>
  <div class="chat" id="chat" aria-live="polite">
    <% if (!messages.length) { %><p class="muted" id="chat-empty"><%= t('Belum ada pesan. Mulai percakapan di bawah.') %></p><% } %>
    <% messages.forEach((m) => { %>
      <div class="bubble <%= m.sender_id === user.id ? 'mine' : '' %>"><%= m.body %><time><%= fmt.dateTime(m.created_at) %></time></div>
    <% }) %>
  </div>
  <% if (canSend) { %>
    <form id="chat-form" class="row" style="flex-direction:row">
      <input type="text" name="body" maxlength="2000" required placeholder="<%= t('Tulis pesan…') %>" style="flex:1;min-width:0" aria-label="<%= t('Pesan') %>" value="<%= draft %>">
      <button class="btn" type="submit"><%= t('Kirim') %></button>
    </form>
    <p id="chat-error" class="alert error" hidden></p>
    <script src="/js/chat.js"></script>
  <% } else { %>
    <p class="alert info"><%= t('Member ini mengunci profilnya dan belum bisa menerima pesan darimu.') %></p>
  <% } %>
</section>
<%- include('partials/footer') %>
