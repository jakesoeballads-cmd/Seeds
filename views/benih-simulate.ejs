<%- include('partials/header') %>
<section class="card narrow">
  <h1><%= t('Simulasi Pembayaran') %></h1>
  <p><%= t('Order') %>: <code><%= orderId %></code></p>
  <p class="muted"><%- t('Halaman ini menggantikan Midtrans selama {key} kosong. Pilih hasil pembayaran:', { key: '<code>MIDTRANS_SERVER_KEY</code>' }) %></p>
  <div class="actions">
    <button class="btn" data-result="success"><%= t('Bayar berhasil') %></button>
    <button class="btn secondary" data-result="failed"><%= t('Bayar gagal') %></button>
  </div>
  <p id="sim-message" class="alert" hidden></p>
</section>
<script>
  document.querySelectorAll('[data-result]').forEach((button) => {
    button.addEventListener('click', async () => {
      const msg = document.getElementById('sim-message');
      const res = await fetch('/api/payments/simulate/<%= encodeURIComponent(orderId) %>', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ result: button.dataset.result }),
      });
      const data = await res.json();
      msg.hidden = false;
      msg.className = 'alert ' + (res.ok && data.status === 'success' ? 'success' : 'error');
      msg.textContent = res.ok ? t('Status transaksi: {status}', { status: data.status }) : data.error;
      if (res.ok) setTimeout(() => (window.location.href = '/benih'), 1200);
    });
  });
</script>
<%- include('partials/footer') %>
