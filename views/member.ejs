<%- include('partials/header') %>
<% const statusLabel = { registered: 'Terdaftar', attended: 'Hadir', negotiating: 'Berdiskusi', agreed: 'Disepakati', paid: 'Dibayar' }; %>
<section class="profile-head">
  <%- include('partials/avatar', { url: member.avatarUrl, name: member.fullName, size: 'large' }) %>
  <div>
    <h1><%= member.fullName || t('Member') %><% if (member.isPrivate) { %> <span class="lock" title="<%= t('Profil dikunci') %>">🔒</span><% } %></h1>
    <% if (!member.locked) { %>
      <p class="muted">
        <% if (member.city) { %>📍 <%= member.city %> · <% } %>
        <%= t('Member sejak {date}', { date: fmt.date(member.memberSince) }) %>
      </p>
      <% if (member.bio) { %><p class="bio"><%= member.bio %></p><% } %>
      <% if (member.organizerNames.length) { %>
        <p class="muted"><%= t('Mengadakan kegiatan sebagai') %>: <%= member.organizerNames.join(', ') %></p>
      <% } %>
    <% } %>
    <% if (!member.isOwner && !member.locked) { %>
      <div class="row">
        <a class="btn small" href="<%= user ? '/pesan/' + member.id : '/login?next=' + encodeURIComponent('/pesan/' + member.id) %>">✉️ <%= t('Kirim pesan') %></a>
      </div>
    <% } %>
    <% if (member.isOwner) { %>
      <div class="row">
        <a class="btn small" href="/profil"><%= t('Ubah profil') %></a>
        <a class="btn small ghost" href="/dashboard"><%= t('Dashboard') %></a>
      </div>
      <% if (member.isPrivate) { %><p class="alert info"><%= t('Profilmu dikunci. Hanya kamu yang bisa melihat isi halaman ini.') %></p><% } %>
    <% } %>
  </div>
</section>

<% if (member.locked) { %>
  <section class="card narrow locked">
    <p class="lock-big" aria-hidden="true">🔒</p>
    <h2><%= t('Profil ini dikunci') %></h2>
    <p class="muted"><%= t('Member ini memilih untuk tidak menampilkan profilnya. Kegiatan yang mereka adakan tetap bisa kamu temukan di beranda.') %></p>
    <a class="btn" href="/"><%= t('Kembali ke beranda') %></a>
  </section>
<% } else { %>
  <div class="stats">
    <div class="stat">
      <span class="stat-label"><%= t('Benih disumbangkan') %></span>
      <span class="stat-value">💚 <%= fmt.num(member.donated) %></span>
      <% if (member.badge.current) { %><span class="badge-donor"><%= member.badge.current.icon %> <%= t(member.badge.current.name) %></span><% } %>
    </div>
    <div class="stat">
      <span class="stat-label"><%= t('Poin relawan') %></span>
      <span class="stat-value">🤝 <%= fmt.num(member.volunteerPoints) %></span>
      <% if (member.volunteerBadge.current) { %><span class="badge-donor"><%= member.volunteerBadge.current.icon %> <%= t(member.volunteerBadge.current.name) %></span><% } %>
    </div>
    <div class="stat">
      <span class="stat-label"><%= t('Kegiatan diadakan') %></span>
      <span class="stat-value">🌳 <%= fmt.num(member.programs.length) %></span>
    </div>
    <div class="stat">
      <span class="stat-label"><%= t('Kegiatan diikuti') %></span>
      <span class="stat-value">🌱 <%= fmt.num(member.participations.length) %></span>
    </div>
  </div>

  <section class="card">
    <h2><%= t('Kegiatan yang diadakan') %></h2>
    <% if (!member.programs.length) { %>
      <p class="muted"><%= t('Belum ada kegiatan.') %></p>
    <% } else { %>
      <ul class="activity-list">
        <% member.programs.forEach((p) => { %>
          <li>
            <a href="/kegiatan/<%= p.id %>"><strong><%= p.title %></strong></a>
            <span class="muted"><%= fmt.schedule(p.start_at, p.end_at) %><% if (p.location_name) { %> · <%= p.location_name %><% } %></span>
            <span class="muted"><%= t('oleh {name}', { name: p.organizer_name }) %> · <span class="org-type"><%= t(organizerTypes[p.organizer_type]) %></span> · 🌱 <%= fmt.num(p.benih_collected) %><% if (p.benih_target) { %> / <%= fmt.num(p.benih_target) %><% } %> Benih</span>
          </li>
        <% }) %>
      </ul>
    <% } %>
  </section>

  <section class="card">
    <h2><%= t('Rekam jejak partisipasi') %></h2>
    <% if (!member.participations.length) { %>
      <p class="muted"><%= t('Belum mengikuti kegiatan.') %></p>
    <% } else { %>
      <ul class="activity-list">
        <% member.participations.forEach((x) => { const p = x.program; %>
          <li>
            <a href="/kegiatan/<%= p.id %>"><strong><%= p.title %></strong></a>
            <span class="muted"><%= fmt.schedule(p.start_at, p.end_at) %> · <%- t('oleh {name}', { name: `<a href="/member/${esc(p.organizer_id)}">${esc(p.organizer_name)}</a>` }) %></span>
            <span><%= x.role === 'paid' ? t('Tenaga berbayar') : t('Relawan') %> · <span class="badge <%= x.status %>"><%= t(statusLabel[x.status] || x.status) %></span></span>
          </li>
        <% }) %>
      </ul>
    <% } %>
  </section>
<% } %>
<%- include('partials/footer') %>
