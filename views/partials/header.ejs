<!doctype html>
<html lang="<%= lang %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title><%= title %> · Benih</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Courier+Prime&family=Lato:wght@400;700;900&family=Source+Serif+4:opsz,wght@8..60,600&display=swap">
  <link rel="stylesheet" href="/css/style.css">
  <script>window.BENIH_I18N = <%- JSON.stringify(clientI18n).replace(/</g, '\\u003c') %>;</script>
  <script src="/js/i18n.js"></script>
</head>
<body>
  <header class="topbar">
    <a href="/" class="brand" aria-label="<%= t('Benih, beranda') %>">
      <svg viewBox="0 0 26 30" aria-hidden="true"><path d="M13 28V14" stroke="#74ac00" stroke-width="2.4" stroke-linecap="round" fill="none"/><path d="M13 16C13 9 8 5 2 5c0 7 4 11 11 11Z" fill="#74ac00"/><path d="M13 13c0-6 4-10 11-10 0 6-4 10-11 10Z" fill="#4f7a00"/></svg>Benih</a>
    <nav>
      <% if (user) { %>
        <a href="/dashboard"><%= t('Dashboard') %></a>
        <a href="/program/baru"><%= t('Buat Kegiatan') %></a>
        <a href="/benih" class="pill"><span class="leaf">♥</span> <%= t('Beli Benih') %></a>
        <form action="/logout" method="post" class="inline">
          <button type="submit" class="link"><%= t('Keluar') %></button>
        </form>
      <% } else { %>
        <a href="/benih" class="pill"><span class="leaf">♥</span> <%= t('Donasi') %></a>
        <a href="/login"><%= t('Masuk atau Daftar') %></a>
      <% } %>
      <div class="lang-switch" role="group" aria-label="<%= t('Bahasa') %>">
        <% Object.entries(languages).forEach(([code, l]) => { %>
          <a href="<%= langHref(code) %>" lang="<%= code %>" hreflang="<%= code %>" title="<%= l.label %>" <%- code === lang ? 'aria-current="true"' : '' %>><%= l.short %></a>
        <% }) %>
      </div>
    </nav>
  </header>
  <%# Menu bawah melayang untuk layar ponsel, seperti aplikasi Threads. %>
  <% const tab = (href, match) => (match ? 'aria-current="page"' : ''); %>
  <nav class="bottom-nav" aria-label="<%= t('Menu utama') %>">
    <a href="/" <%- tab('/', currentPath === '/') %>><svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 11.5 12 4l8 7.5V20a1 1 0 0 1-1 1h-4.5v-6h-5v6H5a1 1 0 0 1-1-1z"/></svg><span><%= t('Beranda') %></span></a>
    <a href="/#cari" data-tab="search"><svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="6.5"/><path d="m16 16 4.5 4.5"/></svg><span><%= t('Cari') %></span></a>
    <a href="/program/baru" class="create" <%- tab('/program/baru', currentPath === '/program/baru') %>><svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"/></svg><span><%= t('Buat') %></span></a>
    <a href="/benih" <%- tab('/benih', currentPath.startsWith('/benih')) %>><svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21v-9"/><path d="M12 13C12 8 8.5 5 4 5c0 5 3.5 8 8 8Z"/><path d="M12 11c0-4.5 3-7.5 8-7.5 0 4.5-3 7.5-8 7.5Z"/></svg><span>Benih</span></a>
    <% if (user) { %>
      <a href="/dashboard" <%- tab('/dashboard', currentPath === '/dashboard' || currentPath === '/profil' || currentPath === '/member/' + user.id) %>><svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8.5" r="4"/><path d="M4.5 20.5c1.2-4 4-6 7.5-6s6.3 2 7.5 6"/></svg><span><%= t('Profil') %></span></a>
    <% } else { %>
      <a href="/login" <%- tab('/login', currentPath === '/login' || currentPath === '/register') %>><svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8.5" r="4"/><path d="M4.5 20.5c1.2-4 4-6 7.5-6s6.3 2 7.5 6"/></svg><span><%= t('Masuk') %></span></a>
    <% } %>
  </nav>
  <main class="container">
