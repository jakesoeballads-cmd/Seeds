<% const initials = String(name || '?').trim().split(/\s+/).slice(0, 2).map((w) => w[0]).join('').toUpperCase(); %>
<% if (url) { %>
  <img class="avatar <%= typeof size !== 'undefined' ? size : '' %>" src="<%= url %>" alt="" loading="lazy">
<% } else { %>
  <span class="avatar <%= typeof size !== 'undefined' ? size : '' %>" aria-hidden="true"><%= initials %></span>
<% } %>
